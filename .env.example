# Copy to .env (never committed) and adjust. Never put real financial data or
# credentials in the repository.
APP_ENV=development
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and
# waits about 2 minutes per connection because Docker only listens on IPv4.
DATABASE_URL=postgresql+psycopg://finance:finance@127.0.0.1:5432/finance
TEST_DATABASE_URL=postgresql+psycopg://finance:finance@127.0.0.1:5432/finance_test

# Authentication. "dev" uses a local key pair in .dev-keys/ (development only);
# "jwks" verifies Supabase tokens. See docs/handoff/HUMAN_TODO.md.
AUTH_MODE=dev
# AUTH_MODE=jwks
# AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
# AUTH_AUDIENCE=authenticated
# AUTH_ALGORITHMS=ES256,RS256

# Browser origins allowed to call the API (Expo web dev server). Empty = none.
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
