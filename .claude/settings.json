{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git pull)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(gh auth status)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(docker compose *)",
      "Bash(docker ps *)",
      "Bash(docker ps)",
      "Bash(.venv/Scripts/python.exe *)",
      "Bash(../../.venv/Scripts/python.exe *)",
      "Bash(.venv/bin/python *)",
      "Bash(../../.venv/bin/python *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(mkdir *)",
      "WebSearch",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:docs.sqlalchemy.org)",
      "WebFetch(domain:alembic.sqlalchemy.org)",
      "WebFetch(domain:pyjwt.readthedocs.io)",
      "WebFetch(domain:docs.pydantic.dev)",
      "WebFetch(domain:www.postgresql.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:docs.github.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./.dev-keys/**)",
      "Edit(./apps/mobile/**)",
      "Write(./apps/mobile/**)",
      "Edit(./.github/workflows/mobile-checks.yml)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git push origin --delete *)",
      "Bash(git push origin :*)",
      "Bash(git filter-branch *)",
      "Bash(rm -rf *)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm *)"
    ]
  }
}
